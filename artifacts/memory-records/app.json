{
  "expo": {
    "name": "Memory Records",
    "slug": "memory-records",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/memory-records_icon.png",
    "scheme": "memory-records",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Memory Records needs access to your photo library to select photos for your memory entries.",
        "NSMicrophoneUsageDescription": "Memory Records needs microphone access to record voice notes."
      }
    },
    "android": {
      "package": "app.memoryrecords",
      "versionCode": 2,
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/memory-records_icon.png"
    },
    "plugins": [
      "./plugins/with-local-android-build.cjs",
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/memory-records_icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0f0f1a"
        }
      ],
      "expo-web-browser",
      "expo-image-picker",
      "expo-secure-store",
      "expo-video",
      "expo-audio",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
